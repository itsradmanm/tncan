# ============================================================
# SwipeDeck — .gitignore
# ============================================================

# ── Secrets & Environment ───────────────────────────────────
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local
# Never commit actual secrets; only .env.example files are tracked

# ── Node / npm ──────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.pnpm-store/

# ── Expo / React Native ─────────────────────────────────────
.expo/
dist/
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
android/
ios/
# Expo build artifacts
.expo-shared/

# ── Python / FastAPI ─────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv/
venv/
ENV/
env/
.virtualenv/

# ── Testing ──────────────────────────────────────────────────
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.pytest_cache/
coverage.xml
*.cover
.hypothesis/
nosetests.xml
test-results/

# ── IDEs & Editors ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── TypeScript ────────────────────────────────────────────────
*.tsbuildinfo

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log

# ── Database ──────────────────────────────────────────────────
*.sqlite3
*.db

# ── Alembic ────────────────────────────────────────────────
# (versions directory IS tracked, env.py IS tracked)

# ── Docker ────────────────────────────────────────────────────
.docker/

# ── Misc ─────────────────────────────────────────────────────
*.pid
*.seed
*.pid.lock
.cache/
tmp/
temp/
