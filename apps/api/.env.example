# ============================================================
# SwipeDeck API — Environment Configuration Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000

# ── JWT ─────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://swiped_user:swiped_pass@localhost:5432/swiped_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CARD_QUEUE_SIZE=20

# ── Object Storage (S3-compatible) ───────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=swiped-media
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true

# ── CDN ──────────────────────────────────────────────────────
# Base URL for serving processed media (CDN domain in production)
CDN_BASE_URL=http://localhost:9000/swiped-media

# Presigned URL TTL in seconds (1 hour default)
PRESIGNED_URL_TTL=3600

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_DECISIONS_PER_MINUTE=120

# ── Sentry (optional) ────────────────────────────────────────
SENTRY_DSN=

# ── ARQ Worker ───────────────────────────────────────────────
ARQ_REDIS_URL=redis://localhost:6379/1

# ── File Upload Limits ───────────────────────────────────────
MAX_UPLOAD_SIZE_BYTES=524288000
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/avif
ALLOWED_VIDEO_TYPES=video/mp4,video/x-m4v,application/x-mpegurl
