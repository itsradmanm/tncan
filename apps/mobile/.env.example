# Mobile app — environment configuration example
# Copy to .env.local (Expo reads EXPO_PUBLIC_ prefixed vars into the app bundle)
# Never commit .env.local

# ── API ──────────────────────────────────────────────────────
# Base URL for the SwipeDeck API (no trailing slash)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ── Sentry ───────────────────────────────────────────────────
EXPO_PUBLIC_SENTRY_DSN=

# ── Feature Flags ────────────────────────────────────────────
EXPO_PUBLIC_REDUCED_MOTION_DEFAULT=false
